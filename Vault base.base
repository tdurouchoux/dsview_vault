filters:
  and:
    - file.folder.startsWith("contents")
    - file.name != "index"
formulas:
  count_backlinks: file.backlinks.length
properties:
  formula.count_backlinks:
    displayName: Nombre de contenu liés
views:
  - type: table
    name: Latest content
    order:
      - file.name
      - upload_date
      - already_read
      - read_priority
      - relevance
      - link
    sort:
      - property: upload_date
        direction: DESC
    limit: 25
  - type: table
    name: Reading priority
    order:
      - file.name
      - upload_date
      - already_read
      - read_priority
      - relevance
      - link
    sort:
      - property: read_priority
        direction: DESC
      - property: upload_date
        direction: DESC
    limit: 25
    columnSize:
      file.name: 345
